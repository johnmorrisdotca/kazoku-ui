{
  "name": "@johnmorrisdotca/kazoku-ui",
  "version": "0.9.0",
  "description": "Kazoku UI 家族, the family's shared interface parts as their own versioned package: view controls for any 3D or zoomable view (angle, tilt, auto-turn, zoom about the pointer, pan, touch, address state) a light, dark and auto theme switch, a language picker, choices kept in the address and a save-as-image button, each a framework-free custom element and a plain controller. Zero dependencies; the shared 3D renderer takes three.js as an optional peer.",
  "keywords": [
    "view-controls",
    "3d",
    "turntable",
    "orbit",
    "zoom",
    "pan",
    "pinch",
    "custom-element",
    "web-component",
    "accessible",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "theme-switch",
    "dark-mode",
    "language-picker",
    "i18n",
    "address-state",
    "url-state",
    "save-image",
    "png",
    "svg",
    "download",
    "webgl",
    "three",
    "three.js",
    "renderer"
  ],
  "homepage": "https://johnmorrisdotca.github.io/kazoku-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kazoku-ui.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/kazoku-ui/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/view-controls/define.js",
    "./dist/theme-switch/define.js",
    "./dist/language-picker/define.js",
    "./dist/save-image/define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./view-controls": {
      "types": "./dist/view-controls/index.d.ts",
      "import": "./dist/view-controls/index.js",
      "default": "./dist/view-controls/index.js"
    },
    "./view-controls/element": {
      "types": "./dist/view-controls/element.d.ts",
      "import": "./dist/view-controls/element.js",
      "default": "./dist/view-controls/element.js"
    },
    "./view-controls/define": {
      "types": "./dist/view-controls/define.d.ts",
      "import": "./dist/view-controls/define.js",
      "default": "./dist/view-controls/define.js"
    },
    "./theme-switch": {
      "types": "./dist/theme-switch/index.d.ts",
      "import": "./dist/theme-switch/index.js",
      "default": "./dist/theme-switch/index.js"
    },
    "./theme-switch/element": {
      "types": "./dist/theme-switch/element.d.ts",
      "import": "./dist/theme-switch/element.js",
      "default": "./dist/theme-switch/element.js"
    },
    "./theme-switch/define": {
      "types": "./dist/theme-switch/define.d.ts",
      "import": "./dist/theme-switch/define.js",
      "default": "./dist/theme-switch/define.js"
    },
    "./language-picker": {
      "types": "./dist/language-picker/index.d.ts",
      "import": "./dist/language-picker/index.js",
      "default": "./dist/language-picker/index.js"
    },
    "./language-picker/element": {
      "types": "./dist/language-picker/element.d.ts",
      "import": "./dist/language-picker/element.js",
      "default": "./dist/language-picker/element.js"
    },
    "./language-picker/define": {
      "types": "./dist/language-picker/define.d.ts",
      "import": "./dist/language-picker/define.js",
      "default": "./dist/language-picker/define.js"
    },
    "./address-state": {
      "types": "./dist/address-state/index.d.ts",
      "import": "./dist/address-state/index.js",
      "default": "./dist/address-state/index.js"
    },
    "./save-image": {
      "types": "./dist/save-image/index.d.ts",
      "import": "./dist/save-image/index.js",
      "default": "./dist/save-image/index.js"
    },
    "./save-image/element": {
      "types": "./dist/save-image/element.d.ts",
      "import": "./dist/save-image/element.js",
      "default": "./dist/save-image/element.js"
    },
    "./save-image/define": {
      "types": "./dist/save-image/define.d.ts",
      "import": "./dist/save-image/define.js",
      "default": "./dist/save-image/define.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "default": "./dist/renderer/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.mjs",
    "prepublishOnly": "pnpm check",
    "dev": "pnpm build && node scripts/dev.mjs",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test",
    "screenshots": "pnpm site && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "three": "0.186.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
