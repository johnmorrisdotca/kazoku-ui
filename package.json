    "test:freeze": "pnpm site && playwright test e2e/renderer.demo.mjs e2e/scene.demo.mjs e2e/body-label.demo.mjs --project=chromium-desk",
    "screenshots": "pnpm site && node scripts/screenshots.mjs",
    "docs:api": "pnpm build && node scripts/docs.mjs api",
    "docs:check": "pnpm build && node scripts/docs.mjs check",
